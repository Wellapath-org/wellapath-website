# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env.local for development. Set the same values in Vercel for
# production. NEVER commit real values — .env.local and .env are gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# Launch-notification signup (app/api/notify).
#
# RESEND_API_KEY     from https://resend.com/api-keys — "Sending access" is
#                    enough; this code only creates contacts, never sends.
# RESEND_AUDIENCE_ID from https://resend.com/audiences — create an audience
#                    called something like "Launch list" and copy its ID.
#
# If either is missing the form does not pretend to work: the visitor is shown
# an honest error and the address is written to the server log so it can be
# recovered rather than lost.
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# ─────────────────────────────────────────────────────────────────────────────
# Build gate for the danger-sign review.
#
# `npm run build` deliberately FAILS while any entry in
# content/red-flag-labels.ts is marked `reviewed: false`. Those sentences sit at
# the top of every condition page and need a clinician's sign-off.
#
# Set this to true to deploy before that review lands. Remove it the moment the
# labels are signed off — it is the only thing standing between unreviewed
# clinical copy and a frightened reader.
ALLOW_UNREVIEWED_RED_FLAGS=true
