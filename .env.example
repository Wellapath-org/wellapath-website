# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env.local for development. Set the same values in Vercel for
# production. NEVER commit real values — .env.local and .env are gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# Launch-notification signup (app/api/notify).
#
# The form accepts an email address OR a WhatsApp number, either on its own.
#
# DATABASE_URL       the source of truth. Vercel > Storage > Create > Neon
#                    Postgres, then copy the POOLED connection string. It is the
#                    only store that can hold a WhatsApp-only signup, and the one
#                    place /privacy's deletion promise has to be honoured. The
#                    `signups` table is created on first use; no migration step.
#
#                    The Neon integration on Vercel does NOT create this name.
#                    It provisions POSTGRES_URL, which the code reads as a
#                    fallback, so an integrated project needs nothing set here.
#                    Set DATABASE_URL by hand only for local development.
#
# RESEND_API_KEY     from https://resend.com/api-keys — "Sending access" is
#                    enough; this code only creates contacts, never sends.
# RESEND_AUDIENCE_ID from https://resend.com/audiences — create an audience
#                    called something like "Launch list" and copy its ID.
#
# If DATABASE_URL is missing the form does not pretend to work: the visitor is
# shown an honest error and the details are written to the server log so they can
# be recovered rather than lost. Resend missing is less severe, because the
# signup is already stored; it is logged and the launch list is rebuilt from
# /admin/signups instead.
DATABASE_URL=
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# ─────────────────────────────────────────────────────────────────────────────
# Build gate for the danger-sign review.
#
# `npm run build` deliberately FAILS while any entry in
# content/red-flag-labels.ts is marked `reviewed: false`. Those sentences sit at
# the top of every condition page and need a clinician's sign-off.
#
# Set this to true to deploy before that review lands. Remove it the moment the
# labels are signed off — it is the only thing standing between unreviewed
# clinical copy and a frightened reader.
ALLOW_UNREVIEWED_RED_FLAGS=true

# ─────────────────────────────────────────────────────────────────────────────
# Admin dashboard at /admin/signups.
#
# Lists real email addresses and phone numbers, so it sits behind HTTP Basic
# auth (middleware.ts).
# If either value is unset the route DENIES every request — a missing variable
# must never be the thing that publishes a contact list.
#
# Use a long random password, e.g. `openssl rand -base64 24`.
ADMIN_USER=
ADMIN_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# LAUNCHED — the front door.
#
# Unset or anything but "true": wellapath.org is the waitlist and nothing else.
# Every other route 307s back to it, the sitemap is one URL, robots disallows
# the rest, and the header drops the nav because every destination in it is
# closed. /privacy, /notify/thanks and /admin stay reachable, the first because
# the form links to it at the moment consent is given.
#
# "true": the real site. The home page, all 50 condition guides, the full nav
# and a 62-URL sitemap come back. Nothing else changes.
#
# It is read at build, not per request, so it is set-then-redeploy. Vercel only
# applies variables to deployments created after they are added, which means the
# same thing twice over here.
#
# To check the full site while it is still closed:
#   LAUNCHED=true npm run build && LAUNCHED=true npm run check
# The suites are launch-aware and will tell you how many routes they skipped.
# ─────────────────────────────────────────────────────────────────────────────
LAUNCHED=
